    return 18
}

fn spawn_interval_base_ms() -> i64 {
    return 950
}
fn spawn_interval_wave_reduction_ms() -> i64 {
    return 35
}
fn spawn_interval_min_ms() -> i64 {
    return 320
}

fn rapid_fire_interval_percent() -> i64 {
    return 75
}
fn heavy_round_damage() -> i64 {
    return 1
}
fn vitality_health_bonus() -> i64 {
    return 25
}
fn vitality_heal_amount() -> i64 {
    return 45
}
fn mobility_speed_bonus() -> i64 {
    return 28
}
fn mobility_dash_cooldown_ms() -> i64 {
    return 350
}

fn arena_limit_centi() -> i64 {
    return 335
}

fn enemy_spawn_radius_centi() -> i64 {
    return 345
}

fn enemy_speed_wave_bonus_centi() -> i64 {
    return 25
}

fn enemy_speed_wave_bonus_cap_centi() -> i64 {
    return 42
}

fn elite_speed_percent() -> i64 {
    return 82
}

fn initial_spawn_delay_ms() -> i64 {
    return 450
}

fn enemy_initial_contact_cooldown_ms() -> i64 {
    return 200
}

