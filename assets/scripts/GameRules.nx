    print("LICCFG_EXPERIENCE_PICKUP_LIFETIME_SECONDS=" + str_i64(experience_pickup_lifetime_seconds()))
    print("LICCFG_SPAWN_INTERVAL_BASE_MS=" + str_i64(spawn_interval_base_ms()))
    print("LICCFG_SPAWN_INTERVAL_WAVE_REDUCTION_MS=" + str_i64(spawn_interval_wave_reduction_ms()))
    print("LICCFG_SPAWN_INTERVAL_MIN_MS=" + str_i64(spawn_interval_min_ms()))
    print("LICCFG_RAPID_FIRE_INTERVAL_PERCENT=" + str_i64(rapid_fire_interval_percent()))
    print("LICCFG_HEAVY_ROUND_DAMAGE=" + str_i64(heavy_round_damage()))
    print("LICCFG_VITALITY_HEALTH_BONUS=" + str_i64(vitality_health_bonus()))
