    print("LICCFG_NO_TARGET_FIRE_DELAY_MS=" + str_i64(no_target_fire_delay_ms()))
    print("LICCFG_EXPERIENCE_ATTRACTION_RANGE_CENTI=" + str_i64(experience_attraction_range_centi()))
