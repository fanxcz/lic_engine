    print("LICCFG_MOBILITY_SPEED_BONUS=" + str_i64(mobility_speed_bonus()))
    print("LICCFG_MOBILITY_DASH_COOLDOWN_MS=" + str_i64(mobility_dash_cooldown_ms()))
