    return 100
}

fn player_dash_duration_ms() -> i64 {
    return 180
}

fn dash_invulnerability_ms() -> i64 {
    return 340
}

fn enemy_contact_damage() -> i64 {
    return 8
}

fn elite_contact_damage() -> i64 {
    return 13
}

fn enemy_contact_range_centi() -> i64 {
    return 52
}

fn enemy_contact_cooldown_ms() -> i64 {
    return 720
}

fn player_hit_invulnerability_ms() -> i64 {
    return 350
}

fn projectile_speed_centi() -> i64 {
    return 680
}

fn projectile_lifetime_ms() -> i64 {
    return 1100
}

fn projectile_hit_radius_centi() -> i64 {
    return 40
}

fn no_target_fire_delay_ms() -> i64 {
    return 50
}

fn experience_attraction_range_centi() -> i64 {
    return 110
}

fn experience_attraction_speed_centi() -> i64 {
    return 125
}

fn experience_collect_range_centi() -> i64 {
    return 35
}

fn main() {
    print("LICCFG_PLAYER_HEALTH=" + str_i64(player_health()))
    print("LICCFG_PLAYER_SPEED=" + str_i64(player_speed()))
    print("LICCFG_ENEMY_SPEED=" + str_i64(enemy_speed()))
    print("LICCFG_FIRE_INTERVAL_MS=" + str_i64(fire_interval_ms()))
    print("LICCFG_DASH_COOLDOWN_MS=" + str_i64(dash_cooldown_ms()))
    print("LICCFG_ENEMY_SPAWN_BASE=" + str_i64(enemy_spawn_base()))
    print("LICCFG_ENEMY_SPAWN_PER_WAVE=" + str_i64(enemy_spawn_per_wave()))
    print("LICCFG_ENEMY_SPAWN_CAP=" + str_i64(enemy_spawn_cap()))
    print("LICCFG_ENEMY_HEALTH_BASE=" + str_i64(enemy_health_base()))
    print("LICCFG_ENEMY_HEALTH_PER_WAVE=" + str_i64(enemy_health_per_wave()))
    print("LICCFG_ELITE_HEALTH_BONUS=" + str_i64(elite_health_bonus()))
