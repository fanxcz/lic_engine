    print("LICCFG_DASH_INVULNERABILITY_MS=" + str_i64(dash_invulnerability_ms()))
    print("LICCFG_ENEMY_CONTACT_DAMAGE=" + str_i64(enemy_contact_damage()))
    print("LICCFG_ELITE_CONTACT_DAMAGE=" + str_i64(elite_contact_damage()))
    print("LICCFG_ENEMY_CONTACT_RANGE_CENTI=" + str_i64(enemy_contact_range_centi()))
    print("LICCFG_ENEMY_CONTACT_COOLDOWN_MS=" + str_i64(enemy_contact_cooldown_ms()))
    print("LICCFG_PLAYER_HIT_INVULNERABILITY_MS=" + str_i64(player_hit_invulnerability_ms()))
    print("LICCFG_PROJECTILE_SPEED_CENTI=" + str_i64(projectile_speed_centi()))
    print("LICCFG_PROJECTILE_LIFETIME_MS=" + str_i64(projectile_lifetime_ms()))
